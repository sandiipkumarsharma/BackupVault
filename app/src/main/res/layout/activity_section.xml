<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_dark" app:titleTextColor="#FFFFFF" app:subtitleTextColor="#CCFFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator" app:navigationIconTint="#FFFFFF"/>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="24dp"/>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
